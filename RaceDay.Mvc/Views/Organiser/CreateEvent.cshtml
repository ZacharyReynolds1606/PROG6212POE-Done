@model RaceDay.Contracts.Events.CreateEventRequest
<h1>Create Event</h1>

<form asp-action="CreateEvent" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <label asp-for="Name"></label>
    <input asp-for="Name" class="form-control" />

    <label>Description</label>
    <textarea asp-for="Description" class="form-control"></textarea>

    <label>Date</label>
    <input asp-for="EventDate" type="date" class="form-control" />

    <label asp-for="Location"></label>
    <input asp-for="Location" class="form-control" />

    <label asp-for="DistanceKm"></label>
    <input asp-for="DistanceKm" class="form-control" />
    <label asp-for="EventType"></label>
    <select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select>

    <button class="btn btn-success mt-3">
        Create Event
    </button>

</form>