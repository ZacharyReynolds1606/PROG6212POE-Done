@model RaceDay.Mvc.ViewModels.LoginVm

<h1>Login</h1>

<form method="post">

    <label>Email</label>
    <input asp-for="Email" class="form-control" />

    <label>Password</label>
    <input asp-for="Password" class="form-control" />

    <button type="submit" class="btn btn-primary mt-3">
        Login
    </button>

</form>